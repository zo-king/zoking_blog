[Unit]
Description=Zoking Blog production backup
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/zoking-blog/ops.env
ExecStart=/opt/zoking-blog/scripts/ops/backup-production.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h
