[Unit]
Description=Zoking Blog application health check
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/zoking-blog/ops.env
ExecStart=/opt/zoking-blog/scripts/ops/check-production.sh --role app
TimeoutStartSec=2m
