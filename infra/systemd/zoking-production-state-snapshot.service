[Unit]
Description=Write Zoking Blog production state snapshot
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/zoking-blog/ops.env
ExecStart=/opt/zoking-blog/scripts/ops/production-state-snapshot.sh --write
TimeoutStartSec=3m
